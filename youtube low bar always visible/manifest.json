{
  "manifest_version": 3,
  "name": "YT Pixel Progress Bar",
  "version": "1.2.0",
  "description": "Adds a permanent 1px progress bar and current playback time to the bottom of every YouTube video.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Pixel Progress Bar"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
