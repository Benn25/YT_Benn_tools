{
  "manifest_version": 3,
  "name": "YT Hover Sound",
  "version": "2.5.1",
  "description": "Force-unmutes all hover previews; user click still toggles mute. Shift+wheel=speed, Shift+Alt+wheel=scrub.",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "patcher.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}